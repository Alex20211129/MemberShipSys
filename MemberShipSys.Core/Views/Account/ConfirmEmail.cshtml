@{
    ViewData["Title"] = "Email 驗證成功";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-icon text-success-icon">✅</div>
        <h1>Email 驗證成功！</h1>
        <p class="auth-subtitle mb-0">你的帳號已經完成驗證，可以正常登入了。</p>

        <div class="auth-links">
            <a asp-action="Login" class="btn btn-primary w-100">前往登入</a>
        </div>
    </div>
</div>
